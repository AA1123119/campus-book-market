@startmindmap
<style>
mindmapDiagram {
  node {
    BackgroundColor #EEF3FF
    BorderColor #3A7AFE
    FontColor #1F2D3D
    Padding 8
    RoundCorner 10
  }
  rootNode {
    BackgroundColor #2D5BFF
    FontColor white
    FontSize 17
  }
  :depth(1) {
    BackgroundColor #DCE7FF
    FontSize 15
  }
}
</style>
skinparam defaultFontName "Microsoft YaHei"
skinparam backgroundColor #FFFFFF

